<resources>
    <style name="Theme.Alcada" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#080B0F</item>
        <item name="android:navigationBarColor">#080B0F</item>
    </style>
    <style name="Theme.Alcada.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080B0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_alcada_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Alcada</item>
    </style>
</resources>
